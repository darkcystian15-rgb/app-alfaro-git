{
  "name": "inmobiliaria-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && netlify deploy --prod --dir=dist",
    "quickpush": "git add . && (git diff --cached --quiet && echo '⚠️ No hay cambios para subir' || git commit -m 'update') && git pull --no-rebase origin main && git push origin main && echo '✅ Cambios enviados correctamente 🚀'",
    "test": "node --test tests/portal.test.mjs tests/visual-v2.test.mjs tests/selection.test.mjs",
    "test:browser": "node tests/portal.browser.mjs",
    "preview:readonly": "node tests/portal-preview.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "@supabase/supabase-js": "^2.55.0",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.540.0",
    "mysql2": "^3.15.3",
    "opentype.js": "^2.0.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.22.3",
    "sharp": "^0.35.5",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "playwright": "1.64.1",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.4.1",
    "vite": "^4.5.0"
  }
}
